# RPC + chain the dashboard reads from (Coston2 by default).
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_CHAIN_ID_HEX=0x72
NEXT_PUBLIC_CHAIN_NAME=Flare Testnet Coston2
NEXT_PUBLIC_EXPLORER_URL=https://coston2-explorer.flare.network

# Copy these from `npx hardhat run scripts/deploy.js` output.
NEXT_PUBLIC_INSURANCE_POOL_ADDRESS=0xYourInsurancePoolAddress
NEXT_PUBLIC_RISK_ORACLE_ADDRESS=0xYourRiskOracleConsumerAddress
NEXT_PUBLIC_FTSO_CONSUMER_ADDRESS=0xYourFtsoV2ConsumerAddress

# Comma-separated list of FAsset agent addresses to show on the dashboard —
# same addresses you put in tee-agent/.env's MONITORED_AGENTS.
NEXT_PUBLIC_AGENT_ADDRESSES=0xMockAgentAAddress,0xMockAgentBAddress
