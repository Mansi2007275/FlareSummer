# Wallet for the risk-scoring agent. This address must match the `reporter`
# address set on RiskOracleConsumer (see contracts/scripts/deploy.js output,
# or call riskOracle.setReporter() after the fact).
# Create a dedicated wallet for this — do not reuse your deployer key.
AGENT_PRIVATE_KEY=0xyour_agent_wallet_private_key

# RPC + contract addresses — copy the RISK_ORACLE_ADDRESS / FTSO_CONSUMER_ADDRESS
# and mock agent addresses printed by `npx hardhat run scripts/deploy.js`.
RPC_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114
RISK_ORACLE_ADDRESS=0xYourRiskOracleConsumerAddress
FTSO_CONSUMER_ADDRESS=0xYourFtsoV2ConsumerAddress

# Comma-separated list of FAsset agent addresses to score every cycle.
# Populate with your MockFAssetAgent addresses for the demo, or real
# FAssets AssetManager agent-vault addresses in production.
MONITORED_AGENTS=0xMockAgentAAddress,0xMockAgentBAddress

# How often to re-run the scoring loop, in seconds.
SCORING_INTERVAL_SECONDS=60

# Model version tag, bumped whenever the scoring weights change. Included in
# the on-chain attestation so a score can always be traced to the model that
# produced it, without revealing what the model actually does differently
# between versions.
MODEL_VERSION=1

# Optional: only needed if you swap the local heuristic model in
# risk_model.py for an LLM-assisted volatility/news read. Never required for
# the default scoring path.
ANTHROPIC_API_KEY=
