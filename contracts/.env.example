# Wallet used to deploy contracts. Create a FRESH wallet for this hackathon —
# never reuse a wallet that holds real funds. Export from MetaMask via
# Account Details -> Export Private Key. Never commit the real .env file.
PRIVATE_KEY=fff407bf344505c84bbce9f199a85190edb7ad3ce79cdc5511d39f3dfc79ce7e

# Network RPC URLs (public defaults shown — override only if you have your own node/RPC provider)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc

# Block explorer API key, for `npx hardhat verify`. Get one from
# https://coston2-explorer.flare.network (Account -> API Keys). Optional but
# makes the deployed contract readable/verified for judges.
FLARESCAN_API_KEY=your_flarescan_api_key

# Reference only — used by deploy.js for logging, not required by hardhat.config.js
COSTON2_CHAIN_ID=114
FLARE_CHAIN_ID=14

# Wallet address of the off-chain TEE risk agent (tee-agent/.env's derived address).
# This becomes RiskOracleConsumer's `reporter` and is the only address allowed
# to submit risk scores. Leave blank on first deploy to default to the deployer,
# then call setReporter() once you know the agent's address.
TEE_AGENT_ADDRESS=

# Wallet address allowed to call reportVerifiedLiquidation() on InsurancePool
# (stands in for an FDC-attestation-verifying relayer in this hackathon build).
# Leave blank on first deploy to default to the deployer.
CLAIMS_VERIFIER_ADDRESS=
